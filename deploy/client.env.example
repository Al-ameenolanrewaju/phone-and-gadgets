# Copy these values into the environment for ONE client installation.
# Never commit real credentials. Use a separate database and SECRET_KEY per client.

APP_ENV=production
SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/CLIENT_DATABASE
COOKIE_SECURE=true

STORE_NAME=Example Clothing
STORE_SLUG=example-electronics
STORE_DESCRIPTION=Clothing and accessories
STORE_OWNER_NAME=Store Owner
STORE_OWNER_EMAIL=owner@example.com
STORE_OWNER_PASSWORD=replace-with-a-unique-password-at-least-12-characters
STORE_CONTACT_EMAIL=hello@example.com
STORE_WHATSAPP_NUMBER=2348012345678
